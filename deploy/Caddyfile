# Reverse proxy for the app and each Bot's live screen, per docs/computer.md § Proxy.
# voxl listens on 127.0.0.1 and checks its own token, so the screen route needs no
# extra login; the app itself keeps botd's Basic auth.
#
# The screen port is 6800 + SCREEN_BASE + slot: 6901, 6902, ... by default
# (SCREEN_BASE=100). Widen the range below if you raise SCREEN_BASE.
:4788 {
	@screen path_regexp screen ^/screen/(69\d\d|70\d\d)/
	handle @screen {
		uri strip_prefix /screen/{re.screen.1}
		reverse_proxy 127.0.0.1:{re.screen.1}
	}
	handle {
		reverse_proxy 127.0.0.1:4787
	}
}
